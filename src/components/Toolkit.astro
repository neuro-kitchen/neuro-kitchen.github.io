---
import ToolCard from './ToolCard.astro';
import { tools } from '../data/tools';
---

<section id="projects" class="container toolkit">
  <h2 class="section-title">The toolkit</h2>
  <div class="grid">
    {tools.map((tool) => <ToolCard tool={tool} />)}
  </div>
</section>

<style>
  .toolkit {
    padding-bottom: 96px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }
</style>

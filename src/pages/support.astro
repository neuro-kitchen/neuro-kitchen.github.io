---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { knownIssues } from '../data/github';

const repo = 'neuro-kitchen/dsp-kitchen';
const issues = await knownIssues(repo);
const forms = [
  { title: 'Report a bug', text: 'Something fails, crashes, hangs or errors.', template: 'bug_report.yml' },
  { title: 'Report wrong results', text: 'It runs, but the output differs from SciPy, NumPy, an upstream sorter or another runtime.', template: 'wrong_results.yml' },
  { title: 'Ask for a feature', text: 'An operation, format, sorter or binding you need.', template: 'feature_request.yml' },
];
---

<Base title="Report a problem · neuro-kitchen" description="Report a bug or wrong results in dsp-kitchen, see known issues, or report a vulnerability.">
  <Header />
  <main id="main" class="container page">
    <h1 class="section-title">Report a problem</h1>
    <p class="lead">Each form asks for what's needed to reproduce it, and opens on GitHub.</p>

    <ul class="forms">
      {forms.map((f) => (
        <li>
          <a href={`https://github.com/${repo}/issues/new?template=${f.template}`}>{f.title}</a>
          <span>{f.text}</span>
        </li>
      ))}
    </ul>

    <section>
      <h2>Known issues</h2>
      {issues.length === 0 ? (
        <p class="muted">None open in <a href={`https://github.com/${repo}/issues`}>dsp-kitchen</a>.</p>
      ) : (
        <ul class="issues">
          {issues.map((i) => (
            <li>
              <a href={i.url}>{i.title}</a>
              <span class="mono">#{i.number} · {i.updated}</span>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section>
      <h2>Report a vulnerability</h2>
      <p class="muted">
        Please don't open a public issue. <a href={`https://github.com/${repo}/security/advisories/new`}>Report it privately</a>,
        as the <a href={`https://github.com/${repo}/blob/main/SECURITY.md`}>security policy</a> describes.
      </p>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .page { padding-block: 56px 96px; max-width: 820px; }
  .lead { color: var(--text-2); font-size: 18px; margin: 12px 0 32px; }
  ul { list-style: none; margin: 0; padding: 0; }
  .forms li { display: grid; grid-template-columns: 200px 1fr; gap: 16px; padding-block: 16px; border-top: 1px solid var(--line); }
  .forms a { font-weight: 600; }
  .forms span, .muted { color: var(--text-2); }
  section { margin-top: 56px; }
  h2 { font-size: 24px; letter-spacing: -0.02em; margin: 0 0 12px; }
  .issues li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding-block: 12px; border-top: 1px solid var(--line); }
  .issues span { color: var(--text-3); }
  @media (max-width: 600px) { .forms li { grid-template-columns: 1fr; gap: 4px; } }
</style>

---
interface Props { size?: number }
const { size = 30 } = Astro.props;
---

<!-- The neuro-kitchen logo (simplified for small sizes: ash circle, neon-green spike, chef hat
     resting on the spike's peak). Full set: the logo's source repository / assets. -->
<svg width={size} height={size} viewBox="0 0 512 512" aria-hidden="true" class="logo">
  <circle id="background" cx="256" cy="256" r="256" fill="#1A1A1A"/><g id="mark"><path id="spike" d="M88 330 H176 L206 434 L250 288 L300 364 L328 330 H424" fill="none" stroke="#C6F26B" stroke-width="40" stroke-linecap="round" stroke-linejoin="round"/><g id="chef-hat" transform="rotate(-12 250 288)"><circle cx="172" cy="172" r="62" fill="#F5F7FA"/><circle cx="250" cy="130" r="80" fill="#F5F7FA"/><circle cx="328" cy="168" r="64" fill="#F5F7FA"/><path id="hat-body" d="M138 186 C190 200 310 200 362 186 L358 244 H142 Z" fill="#F5F7FA"/><rect id="brim" x="128" y="236" width="244" height="54" rx="8" fill="#D5DBE3"/></g></g>
</svg>

<style>
  .logo { flex: none; }
</style>

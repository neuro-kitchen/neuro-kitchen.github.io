---
// The landing: what neuro-kitchen is, the two tools to try at once in the browser, live numbers
// (read at build time), then the apps themselves. The screenshot tabs are radio buttons styled
// with :has(): no script, so the site's Content-Security-Policy stays as strict as it is.
import { toolStats } from '../data/github';
import { tools } from '../data/tools';

const stats = await toolStats();
const viewer = (name: string) => tools.find((t) => t.name === name)?.viewer;

const shots = [
  {
    id: 'dsp-explore',
    tab: 'dsp-kitchen · Explore',
    src: '/screens/dsp-explore.webp',
    width: 1543,
    height: 865,
    alt: 'dsp-kitchen in the browser, in Explore: a 385-channel Neuropixels recording as traces and a heatmap, the channels on the left, the Inspector on the right and the timeline below',
    caption: 'In your browser: a 385-channel Neuropixels recording as traces and a heatmap, processed on the browser’s GPU (WebGPU). Recording: International Brain Laboratory, Kilosort4’s example dataset.',
  },
  {
    id: 'dsp-curation',
    tab: 'dsp-kitchen · Curation',
    src: '/screens/dsp-curation.webp',
    width: 1543,
    height: 865,
    alt: 'dsp-kitchen in the browser, in Curation: a Kilosort4 sorting of 292 units, three units selected and compared in waveforms, features, template features, autocorrelograms, ISI, amplitude over time, templates and cross-correlograms, their spikes coloured on four channels below',
    caption: 'Curating a Kilosort4 sorting in your browser: three similar units compared side by side, then merged or split. Recording: International Brain Laboratory, Kilosort4’s example dataset.',
  },
  {
    id: 'lucem-explore',
    tab: 'lucem · Explore',
    src: '/screens/lucem-browser.webp',
    width: 1600,
    height: 924,
    alt: 'lucem in the browser, in Explore: a 59-channel PhenoCycler image of two human tonsil tissue cores, the channels listed in the Layers panel and the Navigator below them',
    caption: 'In your browser: two tonsil cores imaged with 59 markers (PhenoCycler), drawn from the OME-Zarr’s pyramid. Sample: SPACEc example data, CC0 1.0.',
  },
];
---

<section id="top" class="container hero">
  <p class="pill mono"><span class="dot" aria-hidden="true"></span>Free and open source · MIT or Apache-2.0 · no GPU needed, but it helps</p>
  <h1>Research software you can read, run and trust.</h1>
  <p class="lede">
    GPU signal processing and spike sorting, image analysis for histology, data conversion and
    paper management. Open a recording or a slide right here in your browser: nothing to install,
    nothing uploaded.
  </p>
  <div class="actions">
    {viewer('dsp-kitchen') && <a href={viewer('dsp-kitchen')} class="btn btn-primary">Try dsp-kitchen <span aria-hidden="true">→</span></a>}
    {viewer('lucem') && <a href={viewer('lucem')} class="btn btn-primary">Try lucem <span aria-hidden="true">→</span></a>}
    <a href="#install" class="btn">Install</a>
  </div>
  {
    stats.length > 0 && (
      <ul class="stats" aria-label="The tools today">
        {stats.map((s) => (
          <li>
            <span class="stat-name">{s.name}</span>
            {s.version && (
              <a class="mono" href={`https://github.com/${s.repo}/releases`}>
                {s.version}
                {s.released && <span class="muted"> · {s.released}</span>}
              </a>
            )}
            {/* Stars once they say something (a handful reads as a warning, not proof) */}
            {s.stars >= 25 && (
              <a class="mono" href={`https://github.com/${s.repo}/stargazers`} aria-label={`${s.stars} stars on GitHub`}>
                ★ {s.stars}
              </a>
            )}
          </li>
        ))}
      </ul>
    )
  }
</section>

<section class="container showcase" aria-label="The apps">
  <fieldset class="tabs">
    <legend class="sr-only">Screenshot</legend>
    {
      shots.map((s, i) => (
        <label>
          <input type="radio" name="shot" value={s.id} checked={i === 0} />
          <span>{s.tab}</span>
        </label>
      ))
    }
  </fieldset>
  <div class="frame">
    <div class="chrome" aria-hidden="true"><span></span><span></span><span></span></div>
    {
      shots.map((s, i) => (
        <figure class="shot" data-shot={s.id}>
          <img src={s.src} alt={s.alt} width={s.width} height={s.height} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
          <figcaption>
            <span>{s.caption}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  .hero {
    padding-block: 88px 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 28px;
  }
  .pill {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    color: var(--text-2);
  }
  .dot { width: 8px; height: 8px; border-radius: 999px; background: var(--accent); }
  h1 {
    margin: 0;
    font-size: clamp(44px, 7vw, 84px);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 700;
    max-width: 15ch;
  }
  .lede {
    margin: 0;
    font-size: 20px;
    line-height: 1.55;
    color: var(--text-2);
    max-width: 40rem;
  }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }

  /* Live numbers: one row per tool, quiet */
  .stats {
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 28px;
    color: var(--text-2);
    font-size: 15px;
  }
  .stats li { display: flex; align-items: baseline; gap: 12px; }
  .stat-name { font-weight: 600; color: var(--text); }
  .stats a { color: var(--text-2); text-decoration: none; }
  .stats a:hover { color: var(--accent); }
  .muted { color: var(--text-3); }

  /* The apps: a window with tabs */
  .showcase { padding-bottom: 96px; display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .tabs {
    margin: 0;
    padding: 4px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px;
    background: var(--surface);
  }
  .tabs label { position: relative; }
  .tabs input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .tabs span {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    font-size: 14px;
    color: var(--text-2);
  }
  .tabs input:checked + span { background: var(--surface-2); color: var(--text); font-weight: 600; }
  .tabs input:focus-visible + span { outline: 3px solid var(--accent); outline-offset: 2px; }
  .tabs label:hover span { color: var(--text); }

  .frame {
    width: 100%;
    border: 1px solid var(--line-2);
    border-radius: 16px;
    background: #0b0d12;
    overflow: hidden;
    box-shadow: 0 30px 80px -40px rgb(0 0 0 / 0.55);
  }
  .chrome { display: flex; gap: 8px; padding: 12px 14px; background: #12151c; border-bottom: 1px solid #1f2430; }
  .chrome span { width: 11px; height: 11px; border-radius: 999px; background: #2c3242; }
  .shot { margin: 0; display: none; }
  .shot img { display: block; width: 100%; height: auto; }
  .shot figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding: 14px 18px;
    font-size: 14px;
    color: #a7b0c0;
    background: #12151c;
    border-top: 1px solid #1f2430;
  }
  .shot figcaption a { color: #c6f26b; text-decoration: none; font-weight: 500; }
  .shot figcaption a:hover { text-decoration: underline; }
  .showcase:has(input[value='dsp-explore']:checked) [data-shot='dsp-explore'],
  .showcase:has(input[value='dsp-curation']:checked) [data-shot='dsp-curation'],
  .showcase:has(input[value='lucem-explore']:checked) [data-shot='lucem-explore'] {
    display: block;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .hero { padding-block: 56px 32px; }
    .lede { font-size: 18px; }
    .showcase { padding-bottom: 64px; }
    .tabs { border-radius: 16px; }
  }
</style>

---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { projects, releases } from '../data/github';

const history = await Promise.all(projects.map(async (p) => ({ ...p, releases: await releases(p.repo) })));
const released = history.filter((p) => p.releases.length > 0);
---

<Base title="Changelog · neuro-kitchen" description="What changed in each release of the neuro-kitchen tools.">
  <Header />
  <main id="main" class="container page">
    <h1 class="section-title">Changelog</h1>
    <p class="lead">What changed in each release, from GitHub.</p>

    {released.length > 1 && (
      <nav class="jump" aria-label="Projects">
        {released.map((p) => <a href={`#${p.name}`}>{p.name}</a>)}
      </nav>
    )}

    {released.length === 0 && (
      <p>
        No releases could be read right now. See <a href="https://github.com/neuro-kitchen">neuro-kitchen on GitHub</a>.
      </p>
    )}

    {released.map((p) => (
      <section id={p.name} class="project">
        <h2>
          <a href={`https://github.com/${p.repo}/releases`}>{p.name}</a>
        </h2>
        {p.releases.map((r) => (
          <article class="release">
            <header>
              <h3><a href={r.url}>{r.name}</a></h3>
              <time datetime={r.date} class="mono">{r.date}</time>
            </header>
            <div class="notes" set:html={r.html} />
          </article>
        ))}
      </section>
    ))}
  </main>
  <Footer />
</Base>

<style>
  .page { padding-block: 56px 96px; max-width: 820px; }
  .lead { color: var(--text-2); font-size: 18px; margin: 12px 0 32px; }
  .jump { display: flex; flex-wrap: wrap; gap: 16px; margin-bottom: 32px; }
  .project + .project { margin-top: 64px; }
  h2 { font-size: 26px; letter-spacing: -0.02em; margin: 0 0 8px; }
  h2 a, h3 a { color: var(--text); text-decoration: none; }
  h2 a:hover, h3 a:hover { color: var(--accent); }
  .release { border-top: 1px solid var(--line); padding-block: 24px; }
  .release header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px; }
  h3 { margin: 0; font-size: 20px; }
  time { color: var(--text-3); }
  .notes { color: var(--text-2); line-height: 1.6; overflow-wrap: anywhere; }
  .notes :global(h2) { font-size: 18px; margin: 24px 0 8px; color: var(--text); }
  .notes :global(h3) { font-size: 16px; margin: 20px 0 6px; color: var(--text); }
  .notes :global(code) { font-family: var(--mono); font-size: 0.9em; background: var(--surface-2); padding: 1px 5px; border-radius: 4px; }
  .notes :global(ul) { padding-inline-start: 22px; }
  .notes :global(li + li) { margin-top: 6px; }
</style>

---
import type { Tool } from '../data/tools';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const released = Boolean(tool.repo);
---

<article class:list={['card', { upcoming: !released }]}>
  <p class="meta mono">{tool.category}</p>
  <h3>{tool.name}</h3>
  <p class="desc">{tool.description}</p>
  {
    released ? (
      <a href={tool.repo} class="card-link">
        View on GitHub <span aria-hidden="true">→</span>
      </a>
    ) : (
      <p class="badge mono">Coming soon</p>
    )
  }
</article>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .card.upcoming {
    background: transparent;
    border: 1px dashed var(--line-3);
  }
  .meta { margin: 0; color: var(--lime); }
  h3 { margin: 0; font-size: 24px; letter-spacing: -0.02em; }
  .desc { margin: 0; font-size: 16px; line-height: 1.55; color: var(--text-2); }
  .card-link {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-weight: 500;
  }
  .badge {
    margin: auto 0 0;
    align-self: flex-start;
    padding: 6px 12px;
    border: 1px solid var(--line-3);
    border-radius: 999px;
    color: var(--text-2);
  }
</style>

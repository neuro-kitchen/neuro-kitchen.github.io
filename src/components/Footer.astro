---
import { links } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container inner mono">
    <span>© {year} neuro-kitchen · Apache-2.0</span>
    <span>
      <a href={links.github}>GitHub</a> ·
      <a href={links.security}>Security</a> ·
      <a href={links.conduct}>Code of conduct</a>
    </span>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--surface-2); }
  .inner {
    padding-block: 28px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    color: var(--text-3);
  }
</style>
